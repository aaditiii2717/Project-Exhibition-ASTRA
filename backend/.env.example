ASTRA_ENV=production
ASTRA_API_KEY=replace-with-a-32-byte-random-secret-from-your-kms
ASTRA_LEDGER_SIGNING_KEY=replace-with-a-separate-32-byte-random-secret-from-your-kms
ASTRA_CORS_ORIGINS=http://127.0.0.1:4174,http://localhost:4174,https://mission-control.example.gov
ASTRA_MODEL_PATH=/secure/models/astra-approved-model.joblib

# Supabase Auth for login (Project Settings -> API in the Supabase dashboard).
# Use the service_role key: it stays on the server and is never sent to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
